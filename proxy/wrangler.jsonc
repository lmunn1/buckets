{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buckets-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // Tried in order; falls back to the next when one is busy.
    "GEMINI_MODEL": "gemini-flash-lite-latest,gemini-3.8-flash,gemini-flash-latest",
    // Browsers only. Native apps don't send an Origin header. Set to your web
    // app's URL(s), comma-separated, once you deploy the web version.
    "ALLOWED_ORIGINS": "*"
  },
  // 20 messages per minute per IP address.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
  // GEMINI_API_KEY is a secret — never put it in this file.
  // Local dev: proxy/.dev.vars   Production: GitHub secret → deploy workflow.
}
